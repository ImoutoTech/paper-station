{
  "name": "paper-station",
  "version": "1.0.0",
  "description": "a simple BI platform",
  "scripts": {
    "fe": "pnpm --filter @paper-station/frontend run dev",
    "be": "pnpm --filter @paper-station/backend run dev",
    "dev": "pnpm --parallel --filter @paper-station/backend --filter @paper-station/frontend run dev",
    "dev:all": "pnpm --filter @paper-station/* run dev",
    "dev:finder": "pnpm --filter @paper-station/finder run dev",
    "build:fe": "pnpm  --filter @paper-station/frontend run build",
    "build:be": "pnpm  --filter @paper-station/backend run build",
    "build:finder": "pnpm  --filter @paper-station/finder run build",
    "build": "pnpm  --filter @paper-station/* run build",
    "c": "git-cz"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "@fastify/middie": "8.3.3",
      "fastify": "4.29.1",
      "glob": ">=10.5.0",
      "minimatch": ">=9.0.7",
      "picomatch": ">=4.0.4",
      "lodash": ">=4.18.0"
    }
  },
  "keywords": [],
  "author": "youranreus (https://mitsuha.space)",
  "license": "ISC",
  "devDependencies": {
    "commitizen": "^4.3.1",
    "cz-customizable": "^7.5.4"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    }
  },
  "packageManager": "pnpm@10.7.0+sha512.6b865ad4b62a1d9842b61d674a393903b871d9244954f652b8842c2b553c72176b278f64c463e52d40fff8aba385c235c8c9ecf5cc7de4fd78b8bb6d49633ab6"
}
